<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- A coleta pelo cabo usa a porta USB do aparelho como hospedeira. Não obrigatória:
       o app instala em aparelho sem USB hospedeiro e a tela explica (feature 006). -->
  <uses-feature android:name="android.hardware.usb.host" android:required="false" />
</manifest>
